@model Quiz
@{
    ViewData["Title"] = Model.Title;
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="mb-0">@Model.Title</h3>
                <span class="text-muted small">Attempt @ViewBag.AttemptNumber of @Model.MaxAttempts · pass @Model.PassingScore%</span>
            </div>
            <div class="fs-4 fw-bold text-primary" id="timer">@Model.TimeLimitMinutes:00</div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted">@Model.Description</p>
        }
        <form method="post" asp-action="Submit" asp-route-id="@Model.Id" id="quizForm">
            @Html.AntiForgeryToken()
            @{ int qi = 0; }
            @{ var askOrder = ViewBag.OrderedQuestions as List<Question> ?? Model.Questions.ToList(); }
            @foreach (var q in askOrder)
            {
                qi++;
                <div class="card mb-3 p-4">
                    <strong>Q@(qi). @q.Text <span class="text-muted fw-normal small">(@q.Points.ToString("0.#") pts)</span></strong>
                    <div class="mt-3">
                        @if (q.Type == QuestionType.ShortAnswer)
                        {
                            <input name="answers[@q.Id]" class="form-control" placeholder="Your answer" autocomplete="off" />
                        }
                        else if (q.Type == QuestionType.Subjective)
                        {
                            <textarea name="answers[@q.Id]" class="form-control" rows="5" placeholder="Write your answer in your own words…" autocomplete="off"></textarea>
                            <div class="form-text"><i class="bi bi-robot me-1"></i>This written answer is graded automatically against the course material.</div>
                        }
                        else
                        {
                            @foreach (var o in q.Options)
                            {
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="radio" name="answers[@q.Id]" value="@o.Id" id="opt-@o.Id" />
                                    <label class="form-check-label" for="opt-@o.Id">@o.Text</label>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            <button class="btn btn-primary btn-lg w-100 mb-5">Submit quiz</button>
        </form>
    </div>
</div>

@section Scripts {
<script nonce="@Context.CspNonce()">
    let seconds = @Model.TimeLimitMinutes * 60;
    const timerEl = document.getElementById('timer');
    const interval = setInterval(() => {
        seconds--;
        const m = Math.floor(seconds / 60), s = seconds % 60;
        timerEl.textContent = `${m}:${s.toString().padStart(2, '0')}`;
        if (seconds <= 60) timerEl.classList.add('text-danger');
        if (seconds <= 0) {
            clearInterval(interval);
            document.getElementById('quizForm').submit();
        }
    }, 1000);
</script>
}
