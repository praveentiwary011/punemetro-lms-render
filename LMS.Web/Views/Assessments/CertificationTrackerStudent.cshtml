@model List<Enrollment>
@{
    ViewData["Title"] = "Certification Tracker";
    var certs = (List<Certificate>)ViewBag.Certificates;
}
<h2 class="mb-4"><em class="icon ni ni-award me-2"></em>Certification Tracker</h2>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">Progress towards certification</div>
            <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>Course</th><th>Status</th><th>Final grade</th><th>Certificate</th></tr></thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-muted">No enrollments yet.</td></tr>
                }
                @foreach (var e in Model)
                {
                    var cert = certs.FirstOrDefault(c => c.EnrollmentId == e.Id);
                    <tr>
                        <td>@e.Course?.Code — @e.Course?.Title</td>
                        <td>
                            @if (e.Status == EnrollmentStatus.Completed) { <span class="badge text-bg-success">Completed</span> }
                            else { <span class="badge text-bg-primary">In progress</span> }
                        </td>
                        <td>@(e.FinalGrade?.ToString("0.#") ?? "—")</td>
                        <td>
                            @if (cert != null)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Certificates" asp-action="Show" asp-route-id="@cert.Id">Download / print</a>
                            }
                            else if (e.Course?.IssuesCertificate == true) { <span class="text-muted small">On completion</span> }
                            else { <span class="text-muted small">Not offered</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-4 text-center">
            <div class="display-4 text-primary fw-bold">@certs.Count</div>
            <div class="text-muted">certificates earned</div>
            <a class="btn btn-outline-primary mt-3" asp-controller="Certificates" asp-action="Index">View all certificates</a>
        </div>
    </div>
</div>
