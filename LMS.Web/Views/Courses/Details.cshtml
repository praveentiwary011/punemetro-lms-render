@model Course
@{
    ViewData["Title"] = Model.Title;
    var enrollment = (Enrollment?)ViewBag.Enrollment;
    var completedIds = (List<int>)ViewBag.CompletedLessonIds;
    var isStudent = User.IsInRole("Student");
    var totalLessons = Model.Modules.Sum(m => m.Lessons.Count);
    var totalMinutes = Model.Modules.Sum(m => m.Lessons.Sum(l => l.DurationMinutes));
}
<div class="row g-4">
    <div class="col-lg-8">
        <span class="badge text-bg-light">@Model.Code</span>
        @if (Model.Category != null) { <span class="badge text-bg-secondary">@Model.Category.Name</span> }
        <h2 class="mt-2">@Model.Title</h2>
        <p class="text-muted">@Model.Description</p>
        <p class="small text-muted">
            <i class="bi bi-person me-1"></i>@Model.Instructor?.FullName
            · @totalLessons lessons (~@(totalMinutes / 60)h @(totalMinutes % 60)m)
            · @Model.Enrollments.Count enrolled
            @if (Model.StartDate != null) { <text> · starts @Model.StartDate.Value.ToString("MMM d, yyyy")</text> }
        </p>

        <h5 class="mt-4 mb-3">Curriculum</h5>
        <div class="accordion" id="curriculum">
            @{ int mi = 0; }
            @foreach (var module in Model.Modules)
            {
                mi++;
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(mi > 1 ? "collapsed" : "")" data-bs-toggle="collapse" data-bs-target="#mod-@module.Id">
                            @module.Title <span class="text-muted ms-2 small">(@module.Lessons.Count lessons)</span>
                        </button>
                    </h2>
                    <div id="mod-@module.Id" class="accordion-collapse collapse @(mi == 1 ? "show" : "")" data-bs-parent="#curriculum">
                        <ul class="list-group list-group-flush">
                            @foreach (var lesson in module.Lessons)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span>
                                        @if (completedIds.Contains(lesson.Id)) { <i class="bi bi-check-circle-fill text-success me-2"></i> }
                                        else { <i class="bi bi-circle me-2 text-muted"></i> }
                                        @if (enrollment != null)
                                        {
                                            <a asp-action="Learn" asp-route-id="@Model.Id" asp-route-lessonId="@lesson.Id" class="text-decoration-none">@lesson.Title</a>
                                        }
                                        else { @lesson.Title }
                                    </span>
                                    <span class="text-muted small">@lesson.DurationMinutes min</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>

        @if (Model.Announcements.Any())
        {
            <h5 class="mt-4 mb-3">Announcements</h5>
            @foreach (var a in Model.Announcements)
            {
                <div class="card p-3 mb-2">
                    <strong>@a.Title</strong>
                    <div class="text-muted small">@a.Body</div>
                    <div class="text-muted small">@a.CreatedAt.ToString("MMM d, yyyy") · @(a.Author?.FullName ?? "")</div>
                </div>
            }
        }
    </div>
    <div class="col-lg-4">
        <div class="card p-4 mb-4">
            @if (!Model.IsActive)
            {
                <div class="alert alert-warning mb-3"><em class="icon ni ni-alert-circle me-1"></em>This course is deactivated — new enrollments are closed. Enrolled learners keep access.</div>
            }
            @if (enrollment == null && isStudent && Model.IsActive)
            {
                <form method="post" asp-action="Enroll" asp-route-id="@Model.Id">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-primary w-100 btn-lg">Enroll now</button>
                </form>
                <p class="small text-muted text-center mt-2 mb-0">Free enrollment · certificate on completion</p>
            }
            else if (enrollment != null)
            {
                var done = completedIds.Count;
                var lessonsPct = totalLessons == 0 ? 0 : (int)((double)done / totalLessons * 100);
                // Content finished but a required assessment still outstanding → cap at 95%.
                var assessmentPending = enrollment.Status == EnrollmentStatus.Active && Model.RequiresAssessment
                                        && totalLessons > 0 && done == totalLessons;
                var pct = assessmentPending ? 95 : lessonsPct;
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Your progress</span>
                    <span>@pct%@(assessmentPending ? " · Assessment Pending" : "")</span>
                </div>
                <div class="progress mb-3"><div class="progress-bar @(assessmentPending ? "bg-warning" : "")" style="width:@(pct)%"></div></div>
                @if (assessmentPending)
                {
                    <div class="alert alert-warning py-2 px-3 small mb-2"><em class="icon ni ni-alert-circle me-1"></em>You've completed all the lessons. Take the course assessment below to complete the course and earn your certificate.</div>
                    <a class="btn btn-warning w-100 mb-2" href="#assessments">Take the assessment</a>
                }
                <a class="btn btn-primary w-100 mb-2" asp-action="Learn" asp-route-id="@Model.Id">@(pct == 0 ? "Start learning" : "Continue learning")</a>
                <a class="btn btn-outline-secondary w-100 mb-2" asp-controller="Discussions" asp-action="Index" asp-route-courseId="@Model.Id">Discussions</a>
                @if (enrollment.Status == EnrollmentStatus.Active && isStudent)
                {
                    <form method="post" asp-action="Drop" asp-route-id="@Model.Id" data-confirm="Drop this course?">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-link btn-sm text-danger w-100">Drop course</button>
                    </form>
                }
            }
            else
            {
                <a class="btn btn-outline-secondary w-100" asp-controller="Discussions" asp-action="Index" asp-route-courseId="@Model.Id">Discussions</a>
            }
        </div>

        @if (enrollment != null && (Model.Assignments.Any() || Model.Quizzes.Any()))
        {
            <div class="card" id="assessments">
                <div class="card-header">Assessments</div>
                <ul class="list-group list-group-flush">
                    @foreach (var a in Model.Assignments)
                    {
                        <li class="list-group-item">
                            <i class="bi bi-file-earmark-text me-1"></i>
                            <a asp-controller="Assignments" asp-action="Details" asp-route-id="@a.Id" class="text-decoration-none">@a.Title</a>
                            <div class="small text-muted">@(a.DueDate != null ? $"Due {a.DueDate.Value:MMM d}" : "No due date") · @a.MaxPoints pts</div>
                        </li>
                    }
                    @foreach (var q in Model.Quizzes)
                    {
                        <li class="list-group-item">
                            <i class="bi bi-patch-question me-1"></i>
                            @if (isStudent)
                            {
                                <a asp-controller="Quizzes" asp-action="Take" asp-route-id="@q.Id" class="text-decoration-none">@q.Title</a>
                            }
                            else { @q.Title }
                            <div class="small text-muted">@q.TimeLimitMinutes min · @q.MaxAttempts attempts</div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
