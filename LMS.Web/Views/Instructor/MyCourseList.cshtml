@model List<Course>
@{
    ViewData["Title"] = "My courses";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1"><i class="bi bi-journal-bookmark me-2"></i>My courses</h2>
        <p class="text-muted mb-0">Courses you authored. You can edit, update and unpublish these at any time.</p>
    </div>
    <a class="btn btn-primary btn-sm" asp-action="CreateCourse"><i class="bi bi-plus-lg me-1"></i>New course</a>
</div>

@if (!Model.Any())
{
    <div class="card p-4 text-muted">
        You have not authored any courses yet. Use <strong>New course</strong> to create one,
        or ask an Admin or Principal for edit access to an existing course from <a asp-action="AllCourses">All courses</a>.
    </div>
}
else
{
    <div class="card">
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Course</th><th>Category</th><th>Enrolled</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><strong>@c.Code</strong> — @c.Title</td>
                    <td>@(c.Category?.Name ?? "—")</td>
                    <td>@c.Enrollments.Count</td>
                    <td>
                        @if (!c.IsPublished)
                        {
                            <span class="badge text-bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">Draft</span>
                        }
                        else if (!c.IsActive)
                        {
                            <span class="badge text-bg-warning-subtle text-warning-emphasis border border-warning-subtle">Deactivated</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success-subtle text-success-emphasis border border-success-subtle">Published</span>
                        }
                    </td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="ManageCourse" asp-route-id="@c.Id">
                            <i class="bi bi-pencil-square me-1"></i>Manage
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
