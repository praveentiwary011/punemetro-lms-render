@model RegisterVm
@{
    ViewData["Title"] = "Register";
}
<div class="row justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="card p-4">
            <h4 class="mb-3 text-center">Create your account</h4>
            <div asp-validation-summary="All" class="text-danger small"></div>
            <form method="post" asp-action="Register">
                <div class="mb-3">
                    <label class="form-label">Full name</label>
                    <input asp-for="FullName" class="form-control" autofocus />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Password</label>
                    <input asp-for="Password" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                </div>
                <button class="btn btn-primary w-100">Register</button>
            </form>
            <p class="small text-center mt-3 mb-0">Already have an account? <a asp-action="Login">Sign in</a></p>
        </div>
    </div>
</div>
