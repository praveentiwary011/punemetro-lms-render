@model List<Notification>
@{
    ViewData["Title"] = "Notifications";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-bell me-2"></i>Notifications</h2>
    <div class="d-flex gap-2">
        @if (Model.Any(n => n.ReadAt == null))
        {
            <form method="post" asp-action="MarkAllRead">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-primary btn-sm">Mark all read</button>
            </form>
        }
        @if (Model.Any(n => n.ReadAt != null))
        {
            <form method="post" asp-action="ClearRead">
                @Html.AntiForgeryToken()
                <button class="btn btn-outline-danger btn-sm">Clear read</button>
            </form>
        }
    </div>
</div>
<div class="card" style="max-width:800px">
    <ul class="list-group list-group-flush">
        @if (!Model.Any())
        {
            <li class="list-group-item text-muted">No notifications.</li>
        }
        @foreach (var n in Model)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center @(n.ReadAt == null ? "fw-semibold" : "text-muted")">
                <a asp-action="Open" asp-route-id="@n.Id" class="text-decoration-none text-reset">
                    @if (n.ReadAt == null) { <i class="bi bi-dot text-primary fs-4 align-middle"></i> }
                    @n.Title
                </a>
                <span class="small text-muted text-nowrap ms-2">@n.CreatedAt.ToString("MMM d, HH:mm")</span>
            </li>
        }
    </ul>
</div>
