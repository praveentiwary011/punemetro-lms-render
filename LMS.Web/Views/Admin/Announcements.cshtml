@model List<Announcement>
@{
    ViewData["Title"] = "Announcements";
}
<h2 class="mb-4"><i class="bi bi-megaphone me-2"></i>Site announcements</h2>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card p-4">
            <h6 class="mb-3">Publish site-wide announcement</h6>
            <form method="post" asp-action="CreateAnnouncement">
                @Html.AntiForgeryToken()
                <div class="mb-3"><input name="title" class="form-control" placeholder="Title" required /></div>
                <div class="mb-3"><textarea name="body" class="form-control" rows="4" placeholder="Message" required></textarea></div>
                <button class="btn btn-primary">Publish &amp; notify everyone</button>
            </form>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card">
            <ul class="list-group list-group-flush">
                @foreach (var a in Model)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div>
                            <strong>@a.Title</strong>
                            @if (a.Course != null) { <span class="badge text-bg-light">@a.Course.Code</span> }
                            else { <span class="badge text-bg-info">Site-wide</span> }
                            <div class="text-muted small">@a.Body</div>
                            <div class="text-muted small">@a.CreatedAt.ToString("MMM d, yyyy") · @(a.Author?.FullName ?? "")</div>
                        </div>
                        <form method="post" asp-action="DeleteAnnouncement">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@a.Id" />
                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>
