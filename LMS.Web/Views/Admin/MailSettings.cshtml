@model LMS.Web.Services.Email.MailSettings
@{
    ViewData["Title"] = "Email notifications";
    var hasPassword = (bool)ViewBag.HasPassword;
    var failing = (List<EmailOutbox>)ViewBag.Failing;
}
<div class="mb-4">
    <h2 class="mb-1"><i class="bi bi-envelope-at me-2"></i>Email notifications</h2>
    <p class="text-muted mb-0">The mail server used for enrolment confirmations, the weekly new-course digest and day-before reminders.</p>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-body">
                <form method="post" asp-action="SaveMailSettings">
                    @Html.AntiForgeryToken()

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="enabled" name="enabled" value="true" @(Model.Enabled ? "checked" : "") />
                        <label class="form-check-label" for="enabled"><strong>Send email notifications</strong></label>
                        <div class="form-text">While this is off, messages are still queued but nothing is delivered.</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-8">
                            <label class="form-label">Mail server (SMTP host)</label>
                            <input name="host" value="@Model.Host" class="form-control" placeholder="smtp.yourcompany.com" />
                        </div>
                        <div class="col-sm-4">
                            <label class="form-label">Port</label>
                            <input name="port" value="@Model.Port" type="number" class="form-control" />
                        </div>
                    </div>

                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="tls" name="useStartTls" value="true" @(Model.UseStartTls ? "checked" : "") />
                        <label class="form-check-label" for="tls">Use STARTTLS (recommended)</label>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Username <span class="text-muted small">(blank if the server does not require it)</span></label>
                            <input name="user" value="@Model.User" class="form-control" autocomplete="off" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Password</label>
                            <input name="password" type="password" class="form-control" autocomplete="new-password"
                                   placeholder="@(hasPassword ? "•••••••• (leave blank to keep)" : "")" />
                            <div class="form-text">Stored encrypted; never shown again.</div>
                        </div>
                    </div>

                    <div class="row g-3 mt-0">
                        <div class="col-sm-6">
                            <label class="form-label">From address</label>
                            <input name="fromAddress" value="@Model.FromAddress" class="form-control" placeholder="lms@yourcompany.com" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">From name</label>
                            <input name="fromName" value="@Model.FromName" class="form-control" placeholder="Training Team" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label">Application address</label>
                        <input name="baseUrl" value="@Model.BaseUrl" class="form-control" placeholder="https://lms.yourcompany.com" />
                        <div class="form-text">Used to build the links inside emails. Without it, messages are sent without buttons.</div>
                    </div>

                    <button class="btn btn-primary mt-4"><i class="bi bi-check-lg me-1"></i><span>Save settings</span></button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-body">
                <h6 class="mb-2">Send a test</h6>
                <p class="text-muted small">Goes through the same queue and worker as a real notification, so a delivered test proves the whole path.</p>
                <form method="post" asp-action="SendTestEmail" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input name="to" class="form-control form-control-sm" placeholder="you@yourcompany.com" />
                    <button class="btn btn-sm btn-outline-primary text-nowrap"><span>Send test</span></button>
                </form>
                <hr class="my-3" />
                <h6 class="mb-2">Run a scheduled job now</h6>
                <p class="text-muted small">Safe to press twice — anyone already queued for this week's digest, or for tomorrow's reminder, will not receive a second copy.</p>
                <div class="d-flex gap-2 flex-wrap">
                    <form method="post" asp-action="RunEmailJob" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="job" value="weekly" />
                        <button class="btn btn-sm btn-outline-secondary"><span>New-course digest</span></button>
                    </form>
                    <form method="post" asp-action="RunEmailJob" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="job" value="reminders" />
                        <button class="btn btn-sm btn-outline-secondary"><span>Tomorrow's reminders</span></button>
                    </form>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                <h6 class="mb-3">Delivery queue</h6>
                <div class="d-flex gap-4">
                    <div><div class="fs-4 fw-bold">@ViewBag.Queued</div><div class="text-muted small">waiting</div></div>
                    <div><div class="fs-4 fw-bold">@ViewBag.Sent</div><div class="text-muted small">sent</div></div>
                </div>
            </div>
        </div>

        @if (failing.Any())
        {
            <div class="card border-warning">
                <div class="card-body">
                    <h6 class="mb-2 text-warning-emphasis"><i class="bi bi-exclamation-triangle me-1"></i>Recent failures</h6>
                    <ul class="small mb-0 ps-3">
                        @foreach (var f in failing)
                        {
                            <li class="mb-1">
                                <strong>@f.ToAddress</strong> — @f.LastError
                                <span class="text-muted">(attempt @f.Attempts)</span>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        <div class="card mt-4">
            <div class="card-body">
                <h6 class="mb-2">What gets sent</h6>
                <ul class="small text-muted mb-0 ps-3">
                    <li class="mb-2"><strong>On enrolment</strong> — immediately, to the learner who enrolled.</li>
                    <li class="mb-2"><strong>Weekly, Monday morning</strong> — courses published in the last seven days, to active learners who are not already enrolled in them. Nobody receives an empty digest.</li>
                    <li><strong>The day before</strong> — one message per learner covering every enrolled course starting tomorrow and every session scheduled tomorrow.</li>
                </ul>
            </div>
        </div>
    </div>
</div>
