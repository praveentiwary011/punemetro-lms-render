@model List<AuditLog>
@{
    ViewData["Title"] = "Audit log";
    int page = ViewBag.Page;
}
<h2 class="mb-4"><i class="bi bi-journal-text me-2"></i>Audit log</h2>
<div class="card">
    <table class="table table-hover align-middle mb-0">
        <thead><tr><th>Timestamp (UTC)</th><th>User</th><th>Action</th><th>Details</th></tr></thead>
        <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td class="text-nowrap">@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                <td>@log.UserName</td>
                <td><span class="badge text-bg-secondary">@log.Action</span></td>
                <td class="text-muted">@log.Details</td>
            </tr>
        }
        </tbody>
    </table>
</div>
<div class="d-flex gap-2 mt-3">
    @if (page > 1)
    {
        <a class="btn btn-outline-primary btn-sm" asp-action="AuditLog" asp-route-page="@(page - 1)">← Newer</a>
    }
    @if (ViewBag.HasMore == true)
    {
        <a class="btn btn-outline-primary btn-sm" asp-action="AuditLog" asp-route-page="@(page + 1)">Older →</a>
    }
</div>
