<script nonce="@Context.CspNonce()">
    // Highlight the selected menu item and keep its submenu expanded.
    // Fully replaces the theme's NioApp.CurrentLink matcher: its regex approach
    // fails on hrefs with query strings, and it strips 'active' from every item
    // it can't match — collapsing the menu on drill-down pages. Disable it.
    if (window.NioApp) { NioApp.CurrentLink = function () { }; }

    // Ordinary menu pages already arrive correct: the layout marks the active
    // item and opens its submenu server-side, so the sidebar is right at first
    // paint and never visibly re-arranges itself. This pass covers what the
    // server cannot know — drill-down pages with no menu entry of their own —
    // and scrolls the selection into view.
    //
    // It runs IMMEDIATELY, not on 'load': bundle.js above has already created
    // the menu and initialised SimpleBar, whereas 'load' waits for every image
    // and font on the page, which on a cold cache is exactly the window in
    // which the menu was seen to jump.
    (function () {
        var path = window.location.pathname.replace(/\/$/, '').toLowerCase();
        var pathWithQuery = (path + window.location.search).toLowerCase();
        var links = document.querySelectorAll('.nk-menu .nk-menu-link[href]');
        var best = null, bestLen = -1;

        links.forEach(function (link) {
            var href = link.getAttribute('href');
            if (!href || href === '#') return;
            var hrefPath = href.split('#')[0].toLowerCase().replace(/\/$/, '');
            var target = hrefPath.indexOf('?') >= 0 ? pathWithQuery : path;
            var candidate = hrefPath.indexOf('?') >= 0 ? hrefPath : hrefPath.split('?')[0];
            if (candidate && (target === candidate || (candidate !== '' && target.indexOf(candidate + '/') === 0))) {
                if (candidate.length > bestLen) { best = link; bestLen = candidate.length; }
            }
        });

        // Drill-down pages (course player, detail views, …) match no sidebar link,
        // so the item the page belongs under must be resolved another way. Order:
        //   1. exact URL match (above) — real menu pages,
        //   2. in-tab history — the item the user navigated from (context-accurate
        //      for pages reachable from several places, e.g. course Details),
        //   3. an explicit ownership map — deterministic fallback so a fresh tab,
        //      direct link or hard refresh still highlights the right item.
        // This keeps the selected item expanded and highlighted for every submenu
        // and role, regardless of how the page was reached.
        function linkByHref(h) {
            var found = null;
            links.forEach(function (link) {
                if ((link.getAttribute('href') || '').toLowerCase() === h.toLowerCase()) { found = link; }
            });
            return found;
        }

        var KEY = 'lms-active-menu';
        if (best) {
            try { sessionStorage.setItem(KEY, best.getAttribute('href')); } catch (e) { }
        } else {
            var saved = null;
            try { saved = sessionStorage.getItem(KEY); } catch (e) { }
            if (saved) { best = linkByHref(saved); }

            if (!best) {
                // path prefix (lower-case) -> owning menu link href
                var OWN = [
                    ['/courses/learn/', '/Courses/MyCourses?status=ongoing'],
                    ['/courses/details/', '/Courses/MyCourses?status=ongoing']
                ];
                for (var i = 0; i < OWN.length && !best; i++) {
                    if (path.indexOf(OWN[i][0]) === 0) { best = linkByHref(OWN[i][1]); }
                }
            }
        }

        if (best) {
            var li = best.closest('li');
            if (li) li.classList.add('active', 'current-page');
            var sub = best.closest('.nk-menu-sub');
            if (sub) {
                sub.style.display = 'block';
                var parent = sub.closest('li.has-sub');
                if (parent) parent.classList.add('active', 'current-page');
            }
            // Highlighting alone is not enough on a long menu: the sidebar's own
            // scroll container starts at the top on every page load, so an item
            // near the bottom (and any submenu opened under it) is highlighted
            // off-screen and the menu looks like it jumped back to the top.
            // Scroll the SIDEBAR container — never the page — to bring it back.
            //
            // SimpleBar builds and sizes that container asynchronously, so on the
            // first frames after 'load' it still reports nothing to scroll; the
            // submenu opened just above also has to be laid out before the item's
            // position is final. Retry briefly (setTimeout, not rAF, so a
            // background tab still settles) until the measurement is usable.
            var tries = 0;
            (function attempt() {
                if (revealInSidebar(best)) return;
                if (++tries < 25) setTimeout(attempt, 40);
            })();
        }

        // Returns true when it has finished (scrolled, already visible, or the
        // sidebar isn't on screen); false means "measure again shortly".
        function revealInSidebar(link) {
            var menu = document.querySelector('.nk-sidebar-menu');
            if (!menu) return true;
            // SimpleBar moves the overflow onto an inner wrapper; without it the
            // menu element scrolls itself. Until that wrapper exists the menu is
            // still unclipped, so EVERY item measures as "visible" — wait for it
            // rather than concluding there is nothing to do.
            var wrapper = menu.querySelector('.simplebar-content-wrapper');
            if (!wrapper && menu.hasAttribute('data-simplebar')) return false;   // not initialised yet
            var scroller = wrapper || menu;
            if (!scroller.clientHeight) return true;            // sidebar hidden (mobile / off-canvas)

            var lr = link.getBoundingClientRect();
            var sr = scroller.getBoundingClientRect();
            if (lr.top >= sr.top && lr.bottom <= sr.bottom) return true;   // already in view — leave it alone

            var max = scroller.scrollHeight - scroller.clientHeight;
            if (max <= 0) return false;    // off-screen yet "unscrollable" → not sized yet, retry

            // Centre the item in the visible area, clamped to the scroll range.
            var delta = (lr.top - sr.top) - (scroller.clientHeight - lr.height) / 2;
            scroller.scrollTop = Math.max(0, Math.min(max, scroller.scrollTop + delta));
            return true;
        }
    })();
</script>
<script nonce="@Context.CspNonce()">
    // Delegated handlers that replace inline on* attributes removed for the strict
    // Content-Security-Policy (script-src has no 'unsafe-inline').
    document.addEventListener("submit", function (e) {
        var f = e.target.closest("form[data-confirm]");
        if (f && !window.confirm(f.getAttribute("data-confirm"))) e.preventDefault();
    });
    document.addEventListener("click", function (e) {
        var c = e.target.closest("[data-confirm]:not(form)");
        if (c && !window.confirm(c.getAttribute("data-confirm"))) { e.preventDefault(); e.stopPropagation(); }
        if (e.target.closest("[data-action=\"print\"]")) { e.preventDefault(); window.print(); }
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
