@inject LMS.Web.Data.AppDbContext Db
@inject Microsoft.Extensions.Caching.Memory.IMemoryCache Cache
@using LMS.Web.Services
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Memory
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    int unreadNotifications = 0;
    int unreadMessages = 0;
    var fullName = "";
    // Tenant branding: after sign-in the brand is the user's organisation — its
    // logo and name everywhere; the neutral platform brand otherwise.
    var brandLogo = "/images/logo_lms.png";
    var orgName = "";
    if (isAuth)
    {
        var uid = User.GetUserId();
        unreadNotifications = await Db.Notifications.CountAsync(n => n.UserId == uid && n.ReadAt == null);
        unreadMessages = await Db.Messages.CountAsync(m => m.RecipientId == uid && m.ReadAt == null);
        var me = await Db.Users.Where(u => u.Id == uid)
            .Select(u => new { u.FullName, OrgLogo = u.Organisation!.LogoUrl, OrgName = u.Organisation!.Name })
            .FirstOrDefaultAsync();
        fullName = me?.FullName ?? "";
        if (string.IsNullOrWhiteSpace(fullName)) { fullName = User.Identity?.Name ?? ""; }
        if (!string.IsNullOrEmpty(me?.OrgLogo)) { brandLogo = me.OrgLogo; }
        orgName = me?.OrgName ?? "";
    }
    var initials = string.Concat(fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Where(w => char.IsLetter(w[0]) && !w.EndsWith(".")) // skip honorifics like "Dr."
        .Take(2).Select(w => char.ToUpper(w[0])));
    if (initials.Length == 0) { initials = "U"; }
    // Site name changes rarely — cache it instead of querying on every request
    var siteName = await Cache.GetOrCreateAsync("SiteName", async entry =>
    {
        entry.AbsoluteExpirationRelativeToNow = TimeSpan.FromMinutes(5);
        return (await Db.SiteSettings.FindAsync("SiteName"))?.Value ?? "LMS";
    }) ?? "LMS";
    var activeRole = isAuth ? ActiveRole.Get(Context) : "";
    var myRoles = isAuth ? ActiveRole.RolesOf(User) : new List<string>();
    var currentController = (string?)ViewContext.RouteData.Values["controller"] ?? "";
    var currentAction = (string?)ViewContext.RouteData.Values["action"] ?? "";

    // A menu link may be distinguished from a sibling only by a route/query value
    // (e.g. My Courses ?status=ongoing vs ?status=completed), so an optional
    // key/value pair can be compared as well as controller + action.
    string RouteOrQuery(string key)
    {
        var v = Context.Request.Query[key].ToString();
        if (string.IsNullOrEmpty(v) && ViewContext.RouteData.Values.TryGetValue(key, out var rv))
            v = rv?.ToString() ?? "";
        return v;
    }

    string Active(string controller, string? action = null, string? key = null, string? value = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) &&
        (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase)) &&
        (key == null || string.Equals(RouteOrQuery(key), value, StringComparison.OrdinalIgnoreCase))
            ? "active current-page" : "";

    // True when ANY of the given "Controller/Action" (optionally "…?key=value")
    // targets is the current page — used to open and highlight the parent of a
    // submenu on the server, so the sidebar is already correct at first paint
    // instead of being corrected by script after the page has been drawn.
    string Any(params string[] specs)
    {
        foreach (var spec in specs)
        {
            var parts = spec.Split('?');
            var ca = parts[0].Split('/');
            string? key = null, value = null;
            if (parts.Length > 1)
            {
                var kv = parts[1].Split('=');
                key = kv[0];
                value = kv.Length > 1 ? kv[1] : "";
            }
            if (Active(ca[0], ca.Length > 1 ? ca[1] : null, key, value) != "") return "active current-page";
        }
        return "";
    }
}
