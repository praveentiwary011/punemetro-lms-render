@model MigrationJob
@{
    ViewData["Title"] = "Map columns";
    var cols = (List<string>)ViewBag.Columns;
    var sample = (List<Dictionary<string,string>>)ViewBag.Sample;
    var map = (Dictionary<string, LMS.Web.Services.Migration.FieldMap>)ViewBag.Map;
    var fields = (IReadOnlyList<LMS.Web.Services.Migration.MigrationField>)ViewBag.Fields;
}
<nav class="small mb-2"><a asp-action="Index" class="text-decoration-none">Data migration</a><span class="text-muted"> / Map columns</span></nav>
<h2 class="mb-1"><i class="bi bi-diagram-3 me-2"></i>Map columns — @Model.EntityType</h2>
<p class="text-muted">@Model.Organisation?.Name · @Model.FileName · @Model.RowCount rows. Suggestions are matched by column name; correct anything wrong.</p>

<form method="post" asp-action="SaveMap" asp-route-id="@Model.Id">
    @Html.AntiForgeryToken()
    <div class="card mb-3">
        <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>LMS field</th><th>Source column</th><th>Transform</th><th>Setting</th></tr></thead>
            <tbody>
            @foreach (var f in fields)
            {
                map.TryGetValue(f.Name, out var fm);
                <tr>
                    <td style="min-width:12rem">
                        <strong>@f.Label</strong>@if (f.Required) { <span class="text-danger">&nbsp;*</span> }
                        <div class="form-text">@f.Help</div>
                    </td>
                    <td style="min-width:12rem">
                        <select name="column[@f.Name]" class="form-select form-select-sm">
                            <option value="">— not mapped —</option>
                            @foreach (var c in cols)
                            {
                                <option value="@c" selected="@(fm?.Column == c)">@c</option>
                            }
                        </select>
                    </td>
                    <td style="min-width:11rem">
                        <select name="transform[@f.Name]" class="form-select form-select-sm">
                            @foreach (var t in Enum.GetValues<LMS.Web.Services.Migration.MigrationTransform>())
                            {
                                <option value="@((int)t)" selected="@(fm?.Transform == t)">@t</option>
                            }
                        </select>
                    </td>
                    <td style="min-width:14rem">
                        <input name="arg[@f.Name]" value="@fm?.Arg" class="form-control form-control-sm"
                               placeholder="dd/MM/yyyy · Faculty=Trainer;Learner=Trainee · constant" />
                    </td>
                </tr>
            }
            </tbody>
        </table>
        </div>
    </div>
    <button class="btn btn-primary"><i class="bi bi-play me-1"></i><span>Validate (dry run)</span></button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    <div class="form-text mt-2">Validation writes nothing. It stages every row and reports what would happen.</div>
</form>

<h5 class="mt-4 mb-2">First rows as read</h5>
<div class="card">
    <div class="table-responsive">
    <table class="table table-sm mb-0">
        <thead><tr>@foreach (var c in cols) { <th class="small">@c</th> }</tr></thead>
        <tbody>
        @foreach (var r in sample)
        {
            <tr>@foreach (var c in cols) { <td class="small">@(r.TryGetValue(c, out var v) ? v : "")</td> }</tr>
        }
        </tbody>
    </table>
    </div>
</div>
