@using LMS.Web.Services.Setup
@{
    var step = (SetupStep)(ViewBag.Step ?? SetupStep.Welcome);
    var steps = new (SetupStep S, string Label)[]
    {
        (SetupStep.Welcome, "Start"),
        (SetupStep.Database, "Database"),
        (SetupStep.Organisation, "Organisation"),
        (SetupStep.Administrator, "Administrator"),
        (SetupStep.Grading, "AI grading"),
        (SetupStep.Review, "Install"),
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — LMS installation</title>
    <style>
        :root { --ink:#101828; --muted:#667085; --line:#e4e7ec; --brand:#6576ff; --brandink:#3b4ad6; --bg:#f4f5fb; --ok:#067647; --bad:#b42318; }
        * { box-sizing:border-box; }
        body { margin:0; font-family:-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; background:var(--bg); color:var(--ink); }
        .wrap { max-width:820px; margin:0 auto; padding:36px 20px 60px; }
        .brand { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
        .brand img { height:38px; }
        .brand strong { font-size:1.02rem; }
        .steps { display:flex; gap:6px; margin-bottom:18px; flex-wrap:wrap; }
        .steps .s { flex:1 1 90px; font-size:.72rem; color:var(--muted); text-align:center; }
        .steps .bar { height:4px; border-radius:4px; background:#e4e7ec; margin-bottom:6px; }
        .steps .s.done .bar { background:#9aa4ff; } .steps .s.done { color:var(--brandink); }
        .steps .s.cur .bar { background:var(--brand); } .steps .s.cur { color:var(--brandink); font-weight:700; }
        .card { background:#fff; border:1px solid var(--line); border-radius:14px; padding:28px; box-shadow:0 1px 3px rgba(16,24,40,.06); }
        h1 { font-size:1.4rem; margin:0 0 6px; }
        .sub { color:var(--muted); margin:0 0 22px; font-size:.95rem; }
        .err { background:#fef3f2; border:1px solid #fecdca; color:var(--bad); padding:12px 14px; border-radius:10px; margin-bottom:18px; font-size:.9rem; }
        .row { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
        @@media (max-width:600px){ .row{ grid-template-columns:1fr; } }
        .fld { margin-bottom:14px; }
        .fld.full { grid-column:1 / -1; }
        label.lbl { display:block; font-size:.82rem; font-weight:600; margin-bottom:5px; }
        input[type=text], input[type=email], input[type=password], input[type=number], textarea {
            width:100%; padding:9px 11px; border:1px solid var(--line); border-radius:9px; font-size:.92rem; font-family:inherit; }
        input:focus, textarea:focus { outline:2px solid #c7cdff; border-color:var(--brand); }
        .hint { color:var(--muted); font-size:.78rem; margin-top:4px; }
        .opts { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:20px; }
        @@media (max-width:600px){ .opts{ grid-template-columns:1fr; } }
        .opt { border:1.5px solid var(--line); border-radius:12px; padding:14px; cursor:pointer; transition:border-color .15s, background .15s; position:relative; display:block; }
        .opt:hover { border-color:#c7cdff; }
        .opt input { position:absolute; opacity:0; }
        .opt.sel { border-color:var(--brand); background:#f5f6ff; }
        .opt .name { font-weight:600; }
        .opt .tag { font-size:.66rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--brandink); background:#e8ebff; border-radius:20px; padding:2px 8px; margin-left:6px; }
        .opt .desc { color:var(--muted); font-size:.81rem; margin-top:4px; line-height:1.35; }
        .actions { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-top:22px; padding-top:20px; border-top:1px solid var(--line); }
        .btn { border:0; border-radius:9px; padding:11px 20px; font-size:.95rem; font-weight:600; cursor:pointer; text-decoration:none; display:inline-block; }
        .btn-primary { background:var(--brand); color:#fff; } .btn-primary:hover { background:var(--brandink); }
        .btn-ghost { background:#fff; border:1px solid var(--line); color:var(--ink); }
        .back { color:var(--muted); font-size:.88rem; text-decoration:none; margin-right:auto; }
        .back:hover { color:var(--ink); }
        .result { font-size:.87rem; } .result.ok { color:var(--ok); } .result.bad { color:var(--bad); }
        table.sum { width:100%; border-collapse:collapse; font-size:.9rem; }
        table.sum td { padding:9px 0; border-bottom:1px solid var(--line); vertical-align:top; }
        table.sum td.k { color:var(--muted); width:38%; }
        .chk { display:flex; gap:9px; align-items:flex-start; font-size:.88rem; margin-top:10px; }
        .chk input { margin-top:3px; }
        ul.checks { list-style:none; padding:0; margin:0 0 6px; }
        ul.checks li { display:flex; gap:10px; padding:9px 0; border-bottom:1px solid var(--line); font-size:.9rem; align-items:flex-start; }
        ul.checks .ic { width:18px; flex:0 0 18px; text-align:center; font-weight:700; }
        ul.checks .ic.ok { color:var(--ok); } ul.checks .ic.warn { color:#b54708; } ul.checks .ic.bad { color:var(--bad); }
        ul.checks .d { color:var(--muted); font-size:.82rem; }
    </style>
</head>
<body>
    <div class="wrap">
        <div class="brand"><img src="/images/logo_new.png" alt="" /><strong>Learning Management System — installation</strong></div>
        <div class="steps">
            @foreach (var s in steps)
            {
                var cls = s.S == step ? "s cur" : (s.S < step ? "s done" : "s");
                <div class="@cls"><div class="bar"></div>@s.Label</div>
            }
        </div>
        <div class="card">
            @if (TempData["Err"] != null) { <div class="err">@TempData["Err"]</div> }
            @RenderBody()
        </div>
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
